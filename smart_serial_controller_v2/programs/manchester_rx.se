// =============================================================================
// manchester_rx.se  -  Manchester (IEEE 802.3) receiver with CRC-16
// -----------------------------------------------------------------------------
// The partner of manchester_tx.se (same tick rate: 16 ticks per bit).
// IEEE 802.3: bit 1 = low -> high in the middle, bit 0 = high -> low.
//
// How it works (clock recovery from the data):
//   1. Wait for the line to be low (idle), then for it to go high: that is
//      the middle edge of the start bit.  We are now locked.
//   2. 12 ticks (3/4 of a bit) after a middle edge we are in the first half
//      of the next bit, past any edge at the bit boundary.  JMP pin looks
//      at the line: high -> the middle edge will fall, low -> it will rise.
//   3. WAIT for that middle edge.  Its time re-locks us (so the two clocks
//      may differ by several percent), and the level after it IS the bit
//      value: IN pins, 1 samples it 2 ticks later.  Both paths take the
//      same time (JMP got / the delay after WAIT 0).
//   4. After 8 bits: CRC 8 feeds the byte into the CRC-16 register (wire
//      order, LSB first), then PUSH.  Back to step 1, which also waits for
//      the idle line between frames.
//
//   RX word: the byte in bits [31:24] (IN shifts right, LSB first), [23:0] = 0.
//   CRC: SMs_CRC = CRC-16 (SE_CRC_CFG POLY, INIT; reset 0x1021 / 0xFFFF)
//   over all bits received since the last "CRC reset" (EXEC 0xE080), in
//   wire order.  Software compares it with the CRC of the bytes it sent.
//   PUSH noblock: a full RX FIFO drops the byte (RX overflow flag) but the
//   receiver keeps its lock.
//
//   clock: same as manchester_tx: 62 + 128/256 -> 1.6 MHz ticks, 100 kbit/s
//   pins : RX = pin 2: IN_BASE 2, JMP_PIN 2, no outputs  -> PINCTRL 0x00004200
//   shift: IN right, START_PC = 20                      -> SHIFTCTRL 0x00001400
// =============================================================================
.program   manchester_rx
.origin    20
.clkdiv    62 128
.pinctrl   0x00004200
.shiftctrl 0x00001400

start:  WAIT 0, pin 2           // idle: the line must be low first
        WAIT 1, pin 2           // middle edge of the start bit: locked
        SET  x, 7       [9]     // 8 data bits; go to 3/4 of the bit
bit:    JMP  pin, fall          // first half high -> the middle edge falls
        WAIT 1, pin 2           // first half low  -> wait for the rising edge
        JMP  got
fall:   WAIT 0, pin 2   [1]     // wait for the falling edge (+1: same time as JMP got)
got:    IN   pins, 1    [7]     // the level after the middle edge = the bit
        JMP  x--, bit           // ... and on to 3/4 of the next bit
        CRC  8                  // the byte (8 newest ISR bits) -> CRC-16
        PUSH noblock            // byte in [31:24] -> RX FIFO
        JMP  start
