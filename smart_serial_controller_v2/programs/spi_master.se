// =============================================================================
// spi_master.se  -  SPI master, mode 0, MSB first, 8-bit words, framed CS#
// -----------------------------------------------------------------------------
// Made for the PmodSF3 flash on JB (Pmod pin 1..4 = SM pin 0..3):
//   pin 0 = CS# (SET), pin 1 = MOSI (OUT), pin 2 = MISO (IN), pin 3 = SCK
//   (side-set).  Mode 0: SCK idles low, MOSI changes while SCK is low, MISO
//   is sampled when SCK rises.
//
// Framing: CS# stays low for a whole frame of N bytes.
//   TX word 1 of a frame : N, the number of bytes in the frame (1..255)
//   TX words 2 .. N+1    : the bytes to send
//   Every word carries its byte in bits [31:24] (OUT shifts left, so the
//   MSB leaves first; ni_se puts NoC bytes there too).  N = 0 is ignored.
//   One RX word is pushed for every byte sent: the byte read on MISO in
//   bits [7:0] (IN shifts left), bits [31:8] = 0.
// Example, flash READ ID: TX 0x04000000 0x9F000000 0 0 0
//                         RX 0x00 0x20 0xBA 0x19   (CS# low for 4 bytes)
// If the TX FIFO runs empty in the middle of a frame the SM waits with CS#
// low and SCK low (a legal SPI pause), so frames may be longer than the
// 4-word FIFO.  PUSH block: if the RX FIFO is full the clock pauses too, so
// no received byte is ever lost.
//
// One bit = 4 ticks: OUT (SCK low, 2 ticks) + IN + JMP (SCK high, 2 ticks).
//   clock: 100 MHz / 25 = 4 MHz ticks -> SCK = 1 MHz
//   pins : OUT_BASE 1, SET_BASE 0, SET_COUNT 1, IN_BASE 2, SIDE_PIN 3,
//          SIDE_EN, INIT_OUT = CS# high, INIT_OE = pins 0,1,3 -> PINCTRL 0x0B101E11
//   shift: OUT left, IN left, START_PC = 18             -> SHIFTCTRL 0x00001203
// Origin 18, so uart_tx (0..6) + uart_rx (7..17) + spi_master fit together.
// =============================================================================
.program   spi_master
.side_set  1
.origin    18
.clkdiv    25 0
.pinctrl   0x0B101E11
.shiftctrl 0x00001203

frame:  PULL block       side 0     // first word of a frame: byte count N
        OUT  x, 8        side 0     // X = N
        JMP  x--, go     side 0     // N > 0: X = N - 1 bytes after this one
        JMP  frame       side 0     // N = 0: nothing to do
go:     SET  pins, 0     side 0     // CS# low
byte:   PULL block       side 0     // next byte (MSB in bit 31)
        SET  y, 7        side 0
bit:    OUT  pins, 1     side 0 [1] // MOSI = next bit while SCK is low
        IN   pins, 1     side 1     // SCK rises: sample MISO
        JMP  y--, bit    side 1
        PUSH block       side 0     // SCK low; received byte -> RX FIFO
        JMP  x--, byte   side 0
        SET  pins, 1     side 0     // CS# high: end of the frame
        JMP  frame       side 0
