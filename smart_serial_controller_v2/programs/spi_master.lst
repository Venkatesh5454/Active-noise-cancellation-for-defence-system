; se_asm.py listing of programs/spi_master.se
; program spi_master, origin 18, 14 words, side_set 1
;
; addr = word index in the program memory (decimal), code = hex
;
; addr code  line  source
               1  // =============================================================================
               2  // spi_master.se  -  SPI master, mode 0, MSB first, 8-bit words, framed CS#
               3  // -----------------------------------------------------------------------------
               4  // Made for the PmodSF3 flash on JB (Pmod pin 1..4 = SM pin 0..3):
               5  //   pin 0 = CS# (SET), pin 1 = MOSI (OUT), pin 2 = MISO (IN), pin 3 = SCK
               6  //   (side-set).  Mode 0: SCK idles low, MOSI changes while SCK is low, MISO
               7  //   is sampled when SCK rises.
               8  //
               9  // Framing: CS# stays low for a whole frame of N bytes.
              10  //   TX word 1 of a frame : N, the number of bytes in the frame (1..255)
              11  //   TX words 2 .. N+1    : the bytes to send
              12  //   Every word carries its byte in bits [31:24] (OUT shifts left, so the
              13  //   MSB leaves first; ni_se puts NoC bytes there too).  N = 0 is ignored.
              14  //   One RX word is pushed for every byte sent: the byte read on MISO in
              15  //   bits [7:0] (IN shifts left), bits [31:8] = 0.
              16  // Example, flash READ ID: TX 0x04000000 0x9F000000 0 0 0
              17  //                         RX 0x00 0x20 0xBA 0x19   (CS# low for 4 bytes)
              18  // If the TX FIFO runs empty in the middle of a frame the SM waits with CS#
              19  // low and SCK low (a legal SPI pause), so frames may be longer than the
              20  // 4-word FIFO.  PUSH block: if the RX FIFO is full the clock pauses too, so
              21  // no received byte is ever lost.
              22  //
              23  // One bit = 4 ticks: OUT (SCK low, 2 ticks) + IN + JMP (SCK high, 2 ticks).
              24  //   clock: 100 MHz / 25 = 4 MHz ticks -> SCK = 1 MHz
              25  //   pins : OUT_BASE 1, SET_BASE 0, SET_COUNT 1, IN_BASE 2, SIDE_PIN 3,
              26  //          SIDE_EN, INIT_OUT = CS# high, INIT_OE = pins 0,1,3 -> PINCTRL 0x0B101E11
              27  //   shift: OUT left, IN left, START_PC = 18             -> SHIFTCTRL 0x00001203
              28  // Origin 18, so uart_tx (0..6) + uart_rx (7..17) + spi_master fit together.
              29  // =============================================================================
              30  .program   spi_master
              31  .side_set  1
              32  .origin    18
              33  .clkdiv    25 0
              34  .pinctrl   0x0B101E11
              35  .shiftctrl 0x00001203
              36  
  18   80c0   37  frame:  PULL block       side 0     // first word of a frame: byte count N
  19   6028   38          OUT  x, 8        side 0     // X = N
  20   0056   39          JMP  x--, go     side 0     // N > 0: X = N - 1 bytes after this one
  21   0012   40          JMP  frame       side 0     // N = 0: nothing to do
  22   a000   41  go:     SET  pins, 0     side 0     // CS# low
  23   80c0   42  byte:   PULL block       side 0     // next byte (MSB in bit 31)
  24   a047   43          SET  y, 7        side 0
  25   6101   44  bit:    OUT  pins, 1     side 0 [1] // MOSI = next bit while SCK is low
  26   5001   45          IN   pins, 1     side 1     // SCK rises: sample MISO
  27   1099   46          JMP  y--, bit    side 1
  28   8040   47          PUSH block       side 0     // SCK low; received byte -> RX FIFO
  29   0057   48          JMP  x--, byte   side 0
  30   a001   49          SET  pins, 1     side 0     // CS# high: end of the frame
  31   0012   50          JMP  frame       side 0
