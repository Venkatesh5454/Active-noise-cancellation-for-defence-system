// =============================================================================
// uart_tx.se  -  UART transmitter for the serial engine (slide 13)
// -----------------------------------------------------------------------------
// 8 data bits, no parity, 1 stop bit, LSB first.  Each TX FIFO word gives
// one byte in bits [7:0].  The SM ticks at 8 x the baud rate, so every bit
// lasts 8 ticks:  SET/OUT (1 tick) + delay (6 or 7) + JMP (1 tick).
//
//   clock: 100 MHz / (108 + 128/256) = 921.6 kHz = 8 x 115200 baud
//   pins : pin 1 = TXD (Pmod UART role table), idle high
//          OUT_BASE = 1, SET_BASE = 1, SET_COUNT = 1,
//          INIT_OUT pin 1 = 1, INIT_OE pin 1 = 1        -> PINCTRL 0x02200015
//   shift: OUT shifts right (LSB first), START_PC = 0  -> SHIFTCTRL 0x0
// =============================================================================
.program   uart_tx
.origin    0
.clkdiv    108 128
.pinctrl   0x02200015
.shiftctrl 0x00000000

loop: PULL block
      SET  x, 7
      SET  pins, 0  [7]
bit:  OUT  pins, 1  [6]
      JMP  x--, bit
      SET  pins, 1  [7]
      JMP  loop
